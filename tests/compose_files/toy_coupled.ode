# The composition of toy_recipe.toml, written by hand: toy_ep.ode as component "ep",
# and contraction_toy.ode as component "toy", with its dLambda renamed dLambda_toy and
# every derivative multiplied by 0.001 (its seconds onto the model's milliseconds).
# The glue's lmbda and dLambda are new parameters, Ca, SL and dSL are no longer
# parameters but inputs, J is new, and -J is added to dcai_dt.

parameters("ep",
k_up = 0.1,
c_rel = 0.001
)

states("ep", cai = 0.0001, n = 0.5)

expressions("ep")
release = c_rel*n
dcai_dt = release - k_up*cai - J
dn_dt = 0.01*(1 - n) - 0.02*n*cai*1000

parameters("toy",
lmbda = 1.0,
dLambda = 0.0,
SL0 = ScalarParam(1.8, unit="um"),
k_trpn = ScalarParam(100.0, unit="1/s"),
ntrpn = 2.0,
ca50 = ScalarParam(2.5, unit="uM"),
kb = ScalarParam(50.0, unit="1/s"),
ku = ScalarParam(20.0, unit="1/s"),
As = 25.0,
cs = ScalarParam(10.0, unit="1/s"),
Tref = ScalarParam(120.0, unit="kPa")
)

states("toy", CaTRPN = 0.0015974440894568689, B = 0.004, Zs = 0.0)

expressions("toy")
Ca = 1000.0*cai
SL = lmbda*SL0
dSL = 1000.0*dLambda*SL0
Lambda = SL / SL0
dLambda_toy = dSL / SL0
Ca_safe = Max(Ca, 0.0)
dCaTRPN_dt = 0.001*k_trpn * ((Ca_safe / ca50) ** ntrpn * (1.0 - CaTRPN) - CaTRPN)
bound_ca = CaTRPN
dB_dt = 0.001*(kb * CaTRPN * (1.0 - B) - ku * B)
dZs_dt = 0.001*(As * dLambda_toy - cs * Zs)
Ta = Tref * Lambda * B * (Zs + 1.0)
J = 0.07*dCaTRPN_dt
